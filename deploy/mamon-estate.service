[Unit]
Description=Mamon Estate Gleam Application
After=network.target postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/vhosts/mamonestate.com/estate-source
ExecStart=/bin/bash -c '. /var/www/vhosts/mamonestate.com/mamonestate-config.env && exec ./build/erlang-shipment/entrypoint.sh run'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
