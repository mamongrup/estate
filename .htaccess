RewriteEngine On
RewriteRule ^sitemap\.xml$ sitemap-dynamic.php [L]
RewriteRule ^admin(?:\.html)?/?$ api/admin.php [L,QSA]
RewriteRule ^admin-giris/?$ admin-giris.html [L,QSA]
RewriteRule ^admin-oturum/(login|logout)/?$ api/admin-auth.php?action=$1 [L,QSA]
RewriteRule ^admin-api/settings/?$ api/admin-settings.php [L,QSA]
RewriteRule ^htmx/admin/regions/?$ api/admin-regions.php [L,QSA]
RewriteRule ^htmx/admin/listings/?$ api/admin-listings.php [L,QSA]
RewriteRule ^admin-api/region-attractions/?$ api/admin-region-ai.php [L,QSA]
RewriteRule ^admin-api/listing-delete/?$ api/admin-listing-actions.php [L,QSA]
RewriteRule ^admin-api/region-seo/?$ api/admin-region-seo-ai.php [L,QSA]
RewriteRule ^admin-api/region-translate/?$ api/admin-region-translate.php [L,QSA]
RewriteRule ^admin-api/listing-seo/?$ api/admin-listing-seo-ai.php [L,QSA]
RewriteRule ^admin-api/listing-translate/?$ api/admin-listing-translate.php [L,QSA]
RewriteRule ^admin-api/listing/?$ api/admin-listing-actions.php [L,QSA]
RewriteRule ^api/public/?$ api/public.php [L,QSA]
RewriteRule ^api/contact/?$ api/public.php?action=contact [L,QSA]
RewriteRule ^api/csrf/?$ api/csrf.php [L,QSA]
RewriteRule ^index/?$ / [R=301,L]
RewriteRule ^(uye-girisi|uye-ol|sifremi-unuttum)/?$ $1.html [L,QSA]
RewriteRule ^sifre-yenile/?$ sifre-yenile.html [L,QSA]
RewriteRule ^auth/(login|register|forgot-password|reset)/?$ api/auth.php?action=$1 [L,QSA]
RewriteRule ^ilan/([0-9]+)$ ilan.html?id=$1 [L,QSA]
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^(.+)\.html$ /$1 [R=301,L,NE]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^/.]+)/?$ $1.html [L,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(tr|en|de|ru|ar|fr)/?$ index.html [L,QSA]
RewriteRule ^(tr|en|de|ru|ar|fr)/(ilanlar|bolgeler|hakkimizda|iletisim)/?$ index.html [L,QSA]
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
<FilesMatch "\.(jpg|jpeg|png|webp|svg|woff2)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
<FilesMatch "\.(css|js)$">
Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>
<Files "rates-live.js">
Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
Header set Pragma "no-cache"
Header set Expires "0"
</Files>
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml image/svg+xml
</IfModule>
